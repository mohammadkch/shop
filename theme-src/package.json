{
  "dependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "tailwindcss": "^4.1.17"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./src/input.css -o ../public/assets/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ../public/assets/css/app.css --watch",
    "build:js": "vite build --config ./vite.config.mjs"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  }
}
